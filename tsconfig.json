{
  "compilerOptions": {
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "esnext",
    "moduleResolution": "node",
    "target": "es2020",
    "jsx": "react-jsx",
    "allowJs": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["node", "jest"],
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./config/*"]
    },
    "isolatedModules": true
  },
  "include": [
    "src/**/*",
    "config/**/*",
    "config/jest/jest.config.cjs",
    "**/*.test.ts",
    "**/*.test.tsx",
    "./config/jest/setupTests.ts"
  ],
  "exclude": ["node_modules"]
}
